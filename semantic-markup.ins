\generate{
  \file{semantic-markup.sty}{\from{semantic-markup.dtx}{package}}
}

\obeyspaces
\Msg{****************************************************************}
\Msg{*}
\Msg{* semantic-markup.sty extracted successfully.}
\Msg{*}
\Msg{* To install system-wide, move semantic-markup.sty into a}
\Msg{* directory TeX can find, e.g.}
\Msg{*   TEXMFHOME/tex/latex/semantic-markup/}
\Msg{* then run mktexlsr / initexmf --update-fndb as appropriate.}
\Msg{*}
\Msg{****************************************************************}

\endbatchfile
