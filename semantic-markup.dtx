%
% \section{Purpose}
%
% This package provides macros that record the \emph{semantic role}
% of a piece of mathematical text --- ``this is the display name of a
% category,'' ``this is a monomorphism arrow'' --- separately from
% how that role is \emph{typeset}. An author writing
% \cs{catName}\Arg{C} is not choosing a font; they are asserting that
% \texttt{C} names a category, and the package decides what a
% category name looks like.
%
% \begin{quote}
% \textbf{The package's actual design goal}, in the author's own
% words: ``My intention is that if you submit a paper to different
% journals, you shouldn't have to change your markup to accommodate
% different house styles, other than changing setup.'' Concretely:
% \cs{catName}\Arg{Set} (or any semantic macro, anywhere in the
% document body) must be byte-for-byte identical whether the target
% is arXiv, journal~X's house style, or journal~Y's house style. Only
% package-load-time \emph{setup} (\cs{usepackage}\oarg{style=...}%
% \Arg{semantic-markup}; see \S\ref{sec:style-switching}) may differ
% --- never anything in the body text itself.
%
% This is not just an API-ergonomics nicety; it is the whole point of
% the package, and it generalizes the ``macros do the heavy lifting''
% principle used throughout the design decisions below into a
% concrete, checkable test:
% \textbf{the journal-portability test} --- \emph{if satisfying a
% house-style change would ever require touching anything in the
% document body (as opposed to the preamble/setup), the design is
% wrong.} Every design question in this package, past and future, is
% judged against this test.
% \end{quote}
%
% Two consequences follow directly from the test above, and both are
% enforced throughout this package:
% \begin{enumerate}
% \item Two things that look similar on the page but mean different
%   things mathematically must not share a macro, even if that means
%   near-identical default typesetting for two commands (otherwise a
%   house style that \emph{does} want them to look different could
%   not ask for that without editing the body).
% \item One concept must not be given two names merely because it is
%   styled differently in different contexts (otherwise the author
%   would have to choose between the two names based on a
%   presentation decision, rather than on what they mean) --- and, as
%   of this design pass, no macro's presentation may be hard-coded at
%   all: every macro's actual rendering is decided by the active
%   \emph{style} (\S\ref{sec:style-switching}), set once at
%   \cs{usepackage} time, never per use.
% \end{enumerate}
%
% \section{Internal naming}
%
% Package-internal \pkg{expl3} functions use the module prefix
% \texttt{lsm} (for \emph{latex-semantic-markup}), per the naming
% convention \texttt{\textbackslash lsm\_}\emph{module}\texttt{\_}%
% \emph{description}\texttt{:}\emph{args}. These are not intended for
% direct use in documents.
%
% \section{Style switching}
% \label{sec:style-switching}
%
% Every semantic macro in this package (\cs{catName}, \cs{morphMono},
% \ldots) is a thin public wrapper around an internal \pkg{expl3}
% function of the same shape (\cs{lsm_cat_name:n}, \cs{lsm_morph_mono:%
% }, \ldots) that does the actual typesetting. Those internal
% functions are not fixed: each one is a \emph{presentation hook},
% (re)definable as a group, all at once, by a named \emph{style}. This
% hook architecture is not new machinery bolted on for style
% switching; it already existed, one hook per macro, from the first
% version of this package (motivated by the same
% typography/semantics separation), and style switching is built as a
% dispatch layer on top of exactly those existing hooks, rather than
% as some separate mechanism.
%
% A style is selected once, as a package option:
% \begin{verbatim}
% \usepackage[style=default]{semantic-markup}   % built in, default
% \usepackage[style=plain]{semantic-markup}     % built in, alternate
% \end{verbatim}
% and nowhere else. The document body --- every \cs{catName}, every
% \cs{morphCompose}, everything --- is written exactly once and never
% varies with the chosen style; only the single \texttt{style=...}
% key on the \cs{usepackage} line changes between, say, an arXiv
% upload and a journal submission. This is the direct, literal
% implementation of the journal-portability test in \S1.
%
% The mechanism is \pkg{l3keys2e} package-option processing (the
% standard modern \pkg{expl3} idiom for \texttt{key=value}
% \cs{usepackage} options; the same mechanism many CTAN packages use
% for exactly this ``pick a coherent bundle of choices at once''
% pattern), with a single \texttt{.choice:} key, \texttt{style}, in
% the key family \texttt{lsm}. Each choice's code is one function
% (\cs{lsm_style_default:}, \cs{lsm_style_plain:}) that reassigns
% \emph{every} presentation hook in the package in one place, so a
% style is always a complete, coherent bundle --- never a partial
% patch the author has to assemble by hand from individual macro
% redefinitions. \texttt{style} defaults to \texttt{default} via
% \texttt{.initial:n} (confirmed against the current \pkg{l3keys}
% source: \texttt{.initial:n} runs the named choice's code
% immediately at \cs{keys_define:nn} time, so the package works with
% no options at all) and any explicit \texttt{style=...} package
% option is applied afterward via \cs{ProcessKeysPackageOptions}.
%
% Only two styles are built in for now, both illustrating the
% mechanism rather than encoding any real journal's house style yet:
% \begin{description}
% \item[\texttt{default}] The presentation choices already justified,
%   macro by macro, in the sections below (script/bold-upright
%   auto-detected category names, bold sequence names, hook/twohead
%   arrows for mono/epi, \ldots).
% \item[\texttt{plain}] Every \texttt{*Name} family macro
%   (\cs{semName}, \cs{catName}, \cs{catSeqName}, \cs{objName},
%   \cs{morphName}, \cs{morphSeqName}, \cs{chartName}, \cs{atlasName},
%   \cs{coordName}) renders completely unstyled, ambient math
%   typeface --- no script, no bold, no auto-detection. The
%   mono/epi arrows and the compose/compose-head/compose-tail glyphs
%   are left as in \texttt{default}: those are closer to fixed
%   mathematical convention (an arrow shape for a monomorphism,
%   distinct glyphs for three distinct composition operations) than
%   to journal-specific name typography, so a demonstration ``plain''
%   style does not touch them --- a real house-style-specific style
%   built later might, but that is a further design question, not
%   answered here.
% \end{description}
% Adding a further style (a real journal's house style, once one is
% specified) means adding one more \texttt{style / \meta{name}
% .code:n} choice and one more \cs{lsm_style_\meta{name}:} function
% that reassigns the same complete set of hooks; it never means
% touching the public macros or asking a document author to change
% anything in the body.
%
% \begin{quote}
% \textbf{Correction:} an earlier pass of this design claimed no
% existing setup/style-switching precedent could be found in the
% source papers' own preambles. That was wrong --- it was checked for
% \pkg{l3keys2e}/\pkg{kvoptions}/\cs{DeclareOption} specifically and
% none of those are present, but the papers do have a real, working,
% already-proven setup mechanism built directly on plain \pkg{l3keys}
% (verified directly in \texttt{LCS.arXiv.V2.tex} and
% \texttt{M-atlas.tex}, identical in both), just not via any of the
% names checked for. Verbatim, the relevant part of it:
% \begin{verbatim}
% \NewDocumentCommand{\equant}{mm}
%   { \quant:nnn {\exists} {#1} {#2} }
%
% \NewDocumentCommand \setupquant {m}
%   { \keys_set:nn {shmuel / quant} {#1} }
%
% \keys_define:nn {shmuel / quant}
%  {
%   subscript   .choices:nn = { {none, stacked, multiple} { ... } },
%   subscript   .default:n = multiple,
%   subscript   .initial:n = none,
%   parentheses .choices:nn = { {none, single, multiple} { ... } },
%   ...
%  }
% \end{verbatim}
% called once, in the document body, separately from every use site:
% \begin{verbatim}
% \setupquant {parentheses=multiple,subscript=stacked}
% \end{verbatim}
% after which every \cs{equant}/\cs{uquant} call, anywhere in the
% document, renders accordingly, unchanged at the call site. (The
% papers have a second, independent instance of the same pattern,
% \cs{setupset}/\texttt{shmuel / set}, for \cs{set}/\cs{union}/%
% \cs{intersection}.) This is a genuine, production-proven ``setup,
% not markup'' mechanism, and it differs from the package-option
% mechanism above in one respect that matters: it is a \emph{runtime}
% command, not a package-load-time option, so it can be invoked
% anywhere a document needs it, not only on the \cs{usepackage} line.
%
% Accordingly, this package exposes the same \texttt{style} key at
% runtime too, via \cs{setupsemanticmarkup}, built the same way
% \cs{setupquant} is built --- a thin wrapper around \cs{keys_set:nn}
% on the same key family already defined for package options:
% \begin{verbatim}
% \setupsemanticmarkup {style=plain}
% \end{verbatim}
% This does not replace the package-option form; both are kept, since
% both are legitimate and \cs{keys_set:nn} is exactly what
% \cs{ProcessKeysPackageOptions} already calls internally to apply a
% package option --- \cs{setupsemanticmarkup} simply makes the same
% call available at any point in the body, matching the established
% precedent, rather than only once at load time.
%
% This package's styles remain one coherent \texttt{style} bundle
% covering every macro at once, unlike \cs{setupquant}/\cs{setupset}'s
% split into independent per-concept-family setup commands: a
% journal's house style is ordinarily one holistic choice applied
% consistently everywhere, not an independent axis per semantic
% family the way quantifier-rendering-taste and set-builder-rendering-%
% taste are independent of each other for a single author. If a real
% future style needs finer-grained, per-family control, splitting
% \texttt{style} into per-family keys (mirroring \texttt{quant}/%
% \texttt{set} exactly) is a natural extension of this same
% \pkg{l3keys} foundation, not a different mechanism.
% \end{quote}
%
% \section{Abbreviations used in macro names}
%
% Every abbreviated word appearing in a user-level macro name is
% spelled out here, once, so no reader has to guess it from context.
% Family and role prefixes that are already complete English words
% (\texttt{chart}, \texttt{atlas}, \texttt{name}, \texttt{compose})
% are not abbreviations and are not listed.
%
% \begin{description}
% \item[\texttt{sem}] Semantic
% \item[\texttt{cat}] Category
% \item[\texttt{obj}] Object
% \item[\texttt{morph}] Morphism
% \item[\texttt{coord}] Coordinate
% \item[\texttt{seq}] Sequence (as in \cs{catSeqName}: a
%   \emph{sequence of} the preceding concept, not that concept itself)
% \item[\texttt{mono}] Monomorphism
% \item[\texttt{epi}] Epimorphism
% \end{description}
%
% \section{User-level command families}
%
% User-level commands are grouped by the semantic domain they tag,
% each using its own name prefix:
% \begin{itemize}
%   \item \texttt{sem} (Semantic) --- generic / not-yet-classified
%     semantic text
%   \item \texttt{cat} (Category) --- categories (in the
%     category-theoretic sense)
%   \item \texttt{obj} (Object) --- objects of a category
%   \item \texttt{morph} (Morphism) --- morphisms between objects
%   \item \texttt{chart} --- local coordinate charts
%   \item \texttt{atlas} --- atlases of coordinate charts
%   \item \texttt{coord} (Coordinate) --- coordinate systems/functions
% \end{itemize}
% What follows documents what each macro \emph{means} and why it is
% (or is not) distinct from its neighbors --- that does not change
% with the active style. What each macro actually renders as, under
% each built-in style, is in \S\ref{sec:style-switching} and the
% Implementation section below.
%
% \subsection{Generic}
%
% \DescribeMacro{\semName}
% \cs{semName}\Arg{text} (Sem = Semantic) tags \texttt{text} as
% semantically significant without committing to any of the more
% specific domains below. Use this only as a placeholder until a
% more specific macro applies, or for genuinely domain-agnostic
% labels.
%
% \subsection{Categories}
%
% \DescribeMacro{\catName}
% \cs{catName}\Arg{text} (Cat = Category) is the display name of a
% single category, whether an arbitrary/variable category symbol
% (e.g.\ \cs{catName}\Arg{C}) or a long, conventionally-fixed name
% (e.g.\ \cs{catName}\Arg{Set}). The author writes the same macro
% either way and never separately decides a typeface: see the
% ``resolved'' discussion below for why this is one auto-detecting
% macro rather than two.
%
% \DescribeMacro{\catSeqName}
% \cs{catSeqName}\Arg{text} (Cat = Category, Seq = Sequence) is the
% display name of a \emph{sequence or family of categories}, e.g.
% $(\mathscr{A}_\alpha)_{\alpha \in A}$. This is deliberately a
% distinct command from \cs{catName}, not a styling variant of it: a
% sequence of categories is not itself a category, and collapsing the
% two into one macro differentiated only by an optional ``bold''
% switch would silently re-introduce the typography/semantics
% conflation this package exists to remove.
%
% This is exactly the distinction the source papers' own formal
% Conventions/Nomenclature section (\texttt{LCS.arXiv.V2.tex}, the
% \texttt{\textbackslash part\{Conventions\}} beginning at its
% \texttt{part:conv} label; identical in \texttt{M-atlas.tex}) draws,
% verbatim:
% \begin{verbatim}
% Bold upper case script letters will refer to
% sequences of categories, e.g.,
%     $\catseqname{A} \defeq (\catname{A}_\alpha, \alpha \in \Alpha)$.
% \end{verbatim}
% Supporting inline evidence, at the macro definitions themselves: the
% papers' \texttt{catname}/\texttt{catseqname} pair is introduced
% under the single comment ``Select font for categories and sequences
% of categories,'' and separately their \texttt{subcat}/\texttt{SUBCAT}
% pair is commented ``Subcategory'' / ``Sequence of subcategories.''
% The single-vs-sequence distinction is a formally stated rule in the
% source mathematics, not just an inferred pattern.
%
% \begin{quote}
% \textbf{cat vs.\ catname (resolved):} the source papers also use a
% separate, bold-roman \texttt{cat} macro (distinct from
% \texttt{catname}) for names like \texttt{Set} and \texttt{Top}.
% Verbatim, from the source, the macro itself:
% \begin{verbatim}
% % Names of standard categories
% \newcommand \cat [1] {\mathbf{#1}}
% \end{verbatim}
% and, verbatim, the comments at its two call sites:
% \begin{verbatim}
% %Use \cat{Top} for the standard category Top.
% %Use \cat{Set} for the standard category Set.
% \end{verbatim}
% The formal Conventions/Nomenclature section cited above gives the
% actual governing rule, verbatim, and it is not ``standard vs.\
% arbitrary category'': it is a rule about name \emph{length}, already
% used elsewhere in the source (see the \texttt{mathvarname} comment,
% ``Set long names upright, short names italic''), here applied
% specifically to categories:
% \begin{verbatim}
% Upright Latin letters will be used for long names.
% \end{verbatim}
% (immediately followed, in the source, by the \texttt{Ar}/%
% \texttt{Hom}/\texttt{Mor}/\texttt{Ob} definitions and by
% ``\texttt{cat}\Arg{Set} and \texttt{cat}\Arg{Top} are the
% conventional categories of sets and topological spaces''). So
% \texttt{Set}/\texttt{Top} are bold-upright because they are
% \emph{long} (multi-character) names, not because they are a
% distinct semantic kind of category in their own right.
%
% Crucially, the source itself already treats this as mechanical, not
% authorial: \texttt{mathvarname} is not two macros the paper author
% chooses between, it is \emph{one} macro that measures the argument's
% length (via \texttt{xstring}'s \texttt{\textbackslash StrLen}) and
% picks the typeface itself. That settles the design question for
% this package too, on the journal-portability test in \S1: since
% ``long vs.\ short'' here is a mechanical convention with no
% underlying semantic distinction (it is not really ``standard
% category'' vs.\ ``arbitrary category''), offering two macros
% (\cs{catName} and, say, \cs{catStandardName}) would force the
% author to decide a typographic question --- ``is this name long
% enough to count as `standard'?'' --- as a separate step from
% expressing what they mean, exactly the conflation this package
% exists to remove. The correct design is therefore a \emph{single}
% macro, \cs{catName}, that auto-detects: the author writes
% \cs{catName}\Arg{Set} or \cs{catName}\Arg{C} identically and never
% chooses upright vs.\ script. It is implemented via
% \cs{tl_if_single:nTF} (an \pkg{expl3}-native single-token/-item
% test, avoiding an \pkg{xstring} dependency): a single-token argument
% (an ordinary bare-symbol category name) renders in script; anything
% longer renders bold upright, under the \texttt{default} style ---
% see \S\ref{sec:style-switching} for how even \emph{that} choice is
% swapped as a unit by a different style, without the author touching
% \cs{catName}\Arg{Set} itself.
% \end{quote}
%
% \subsection{Objects}
%
% \DescribeMacro{\objName}
% \cs{objName}\Arg{text} (Obj = Object) is the display name of an
% object of a category, corresponding to what the source papers call
% \texttt{Ob}\Arg{catname\Arg{C}}. Verbatim, from the source:
% \begin{verbatim}
% %Object of category
% \newcommand \Ob {\mathrm{Ob}}
% \end{verbatim}
% and, from the papers' later formal definitions:
% \begin{verbatim}
% \item[$\Ob(\catname{C})$]
% All objects of $\catname{C}$
% \end{verbatim}
% Under the \texttt{default} style the presentation is unstyled
% (objects are typically bare math-mode variables in practice); the
% macro exists so that document text records the semantic role even
% when the current style's rendering does nothing visible.
%
% \subsection{Morphisms}
%
% \DescribeMacro{\morphName}
% \cs{morphName}\Arg{text} (Morph = Morphism) is the display
% name/label of a morphism (e.g.\ a function symbol). The
% \texttt{morph} prefix follows the source papers' own explicit
% terminology choice, verbatim:
% \begin{verbatim}
% This paper uses the term morphism in preference to arrow, but uses
% the conventional $\Ar$.
% \end{verbatim}
%
% \begin{quote}
% \textbf{A morphism vs.\ the class of all morphisms (resolved):} by
% the standard definition, a single morphism always has a specific
% source and target --- it is an element of a particular Hom-set.
% That is a different notion from ``the class of all morphisms/arrows
% in a category,'' which has no reference to specific endpoints.
% \cs{morphName} (a label for one morphism, e.g.\ $f$) is already
% built around the correct, standard reading and needs no change.
%
% The source papers name both notions but are, in one place,
% internally inconsistent about which name goes with which. Their
% inline comment directly above the \texttt{Mor} definition reads,
% verbatim:
% \begin{verbatim}
% %Morphisms between two objects
% \newcommand \Mor {\mathrm{Mor}}
% \end{verbatim}
% --- the correct, standard reading (a Hom-set, between two specific
% objects). But the papers' later formal prose defines the same
% macro differently, verbatim:
% \begin{verbatim}
% \item[$\Mor(\catname{C})$]
% All morphisms of $\catname{C}$.
% Synonymous with $\Ar(\catname{C})$.
% \end{verbatim}
% --- treating \texttt{Mor} as a synonym of \texttt{Ar} (the class of
% \emph{all} morphisms), which is the imprecise reading. For
% reference, the papers' formal definitions of the other two related
% operators, verbatim:
% \begin{verbatim}
% \item[$\Ar(\catname{C})$]
% All morphisms of $\catname{C}$
% \item[$\Hom_\catname{C}(a,b)$]
% All morphisms of $\catname{C}$ from $a$ to $b$
% \end{verbatim}
%
% So: \texttt{Ar} denotes the class of all morphisms of a category;
% \texttt{Hom} denotes the Hom-set of morphisms between two specific
% objects (matching the \texttt{Mor} \emph{comment}, not the
% \texttt{Mor} \emph{formal definition}); and ``a morphism'' in the
% ordinary sense is always an element of some Hom-set, i.e.\ it always
% has a specific source and target. \texttt{Ar} and \texttt{Hom} are
% not the same kind of thing and should not be conflated in this
% package, even though the source papers blur the line in this one
% spot. (That blurring is an issue in the papers themselves,
% \texttt{LCS.arXiv.V2.tex}/\texttt{M-atlas.tex}, for their author to
% fix there if desired --- it is not this package's problem to solve,
% only something to have correctly understood here.)
%
% \texttt{morphAll} (the \texttt{Ar} reading: all morphisms of a
% category) and \texttt{morphBetween} (the \texttt{Hom} reading:
% morphisms from one specific object to another) are natural names
% for these two notions but are not built here, pending the author's
% preference on naming.
% \end{quote}
%
% \DescribeMacro{\morphSeqName}
% \cs{morphSeqName}\Arg{text} (Morph = Morphism, Seq = Sequence) is
% the display name of a \emph{sequence or tuple of morphisms/%
% functions}, e.g.\ $\bm{f} \mathrel{:=} (f_1, f_2)$. Like
% \cs{catSeqName}
% vs.\ \cs{catName}, this is a genuinely distinct \pkg{expl3} function
% from \cs{morphName} (\cs{lsm_morph_seqname:n}, not
% \cs{lsm_morph_name:n} with a flag): a sequence of functions is not
% itself a function. See the resolved discussion below.
%
% \DescribeMacro{\morphMono}
% \cs{morphMono} (Mono = Monomorphism) is the arrow symbol for a
% monomorphism, corresponding to the source papers' \texttt{into}.
%
% \DescribeMacro{\morphEpi}
% \cs{morphEpi} (Epi = Epimorphism) is the arrow symbol for an
% epimorphism, corresponding to the source papers' \texttt{onto}.
% This is kept distinct from \cs{morphMono} because mono/epi is a
% real mathematical distinction (injective vs.\ surjective in the
% relevant sense), not a choice of arrowhead glyph.
%
% \DescribeMacro{\morphCompose}
% \cs{morphCompose} is the general morphism-composition operator
% (default $\circ$). An optional argument
% \cs{morphCompose}\oarg{label} places \texttt{label} over the
% operator, mirroring how composition is annotated in the source
% papers.
%
% \DescribeMacro{\morphComposeHead}
% \cs{morphComposeHead} (default $\odot$) is composition taken from
% the head of a sequence of functions.
%
% \DescribeMacro{\morphComposeTail}
% \cs{morphComposeTail} (default $\cdot$) is composition taken from
% the tail of a sequence of functions. Both take the same optional
% label argument as \cs{morphCompose}.
%
% \begin{quote}
% \textbf{Confirmed distinct (resolved):} the source papers define
% \emph{three} composition operators, verbatim:
% \begin{verbatim}
% % Extended composition operators for function sequences
% \newcommand {\compose} [1] [def]
%    { \ifthenelse {\equal{#1}{def}}
%        {\mathbin \circ}
%        {\mathbin{\overset{#1} {\circ}}}
%    }
%
% % Compose head
% \newcommand {\composeh} [1] [def]
%    { \ifthenelse {\equal{#1}{def}}
%        {\mathbin \odot}
%        {\mathbin{\overset{#1} {\odot}}}
%    }
%
% % Compose tail
% \newcommand {\composet} [1] [def]
%    { \ifthenelse {\equal{#1}{def}}
%        {\mathbin \cdot}
%        {\mathbin{\overset{#1} {\cdot}}}
%    }
% \end{verbatim}
% Per the author: plain composition, ``compose head,'' and ``compose
% tail'' are genuinely different mathematical operations, not
% glyph/styling variants of one operation. They are built accordingly
% as three separate \pkg{expl3} functions ---
% \cs{lsm_morph_compose:n}, \cs{lsm_morph_compose_head:n},
% \cs{lsm_morph_compose_tail:n} --- each with its own presentation
% hook, the same treatment already given to \cs{catName}/
% \cs{catSeqName} (\cs{lsm_cat_name:n}/\cs{lsm_cat_seqname:n}): one
% function with a flag would have re-introduced the
% typography/semantics conflation this package exists to remove.
% \end{quote}
%
% \begin{quote}
% \textbf{morphSeqName vs.\ morphName (resolved):} per the author, a
% sequence of functions is not a function, the same principle as the
% \cs{catSeqName}/\cs{catName} and compose/compose-head/compose-tail
% rulings above. This is also the most directly authoritative finding
% in the source: it is not only an inference from scattered inline
% comments or disabled code, but a rule stated outright in the source
% papers' own formal Conventions/Nomenclature section
% (\texttt{\textbackslash part\{Conventions\}}, label
% \texttt{part:conv}; identical text in both \texttt{LCS.arXiv.V2.tex}
% and \texttt{M-atlas.tex}), verbatim:
% \begin{verbatim}
% Bold lower case italic letters will refer to sets, sequences and
% tuples of functions, e.g.,
%     $\funcseqname{f} \defeq (\funcname{f}_1, \funcname{f}_2)$.
% \end{verbatim}
% i.e.\ \texttt{funcname} (a single function) and \texttt{funcseqname}
% (a sequence/tuple of functions) are explicitly distinguished as
% different kinds of object, bold vs.\ not, in the papers' own stated
% rules --- not merely by the disabled macro pair found earlier
% (``Select font for functions and sequences of functions''
% commenting \texttt{funcname}/\texttt{funcseqname}, never actually
% enabled). \cs{morphSeqName} is built accordingly as a genuinely
% distinct \pkg{expl3} function, \cs{lsm_morph_seqname:n}, not
% \cs{lsm_morph_name:n} called with a different flag.
% \end{quote}
%
% \subsection{Charts, atlases, and coordinates}
%
% \DescribeMacro{\chartName}
% \cs{chartName}\Arg{text} is the display name of a local coordinate
% chart.
%
% \DescribeMacro{\atlasName}
% \cs{atlasName}\Arg{text} is the display name of an atlas of charts.
%
% \DescribeMacro{\coordName}
% \cs{coordName}\Arg{text} (Coord = Coordinate) is the display name
% of a coordinate system or coordinate function.
%
% \begin{quote}
% \textbf{Placeholder, thin evidence:} the source papers use only a
% predicate \texttt{isAtl} (``Propositional function isAtl(A,E,C)'')
% and an untyped \texttt{Atl} macro (``Category of atlases from E to
% C'') for this cluster --- there is no existing inline precedent for
% chart/atlas/coordinate \emph{naming} to generalize from, unlike the
% category and morphism families above. These three commands are
% provided as minimal, unstyled hooks under the \texttt{default} style
% so the semantic distinction exists in document markup from the
% start; being ordinary presentation hooks like every other macro in
% this package, they already participate correctly in style switching
% (\S\ref{sec:style-switching}) with no further work needed on that
% front. Whether ``coordinate'' needs sub-kinds (e.g.\ a coordinate
% \emph{function} vs.\ a coordinate \emph{value} vs.\ a coordinate
% \emph{index}) is a separate, still-open semantic question and should
% be settled against real usage before this cluster is trusted as
% final.
% \end{quote}
%
% \end{documentation}
%
% \begin{implementation}
%
% \section{Implementation}
%
%<*package>
% \begin{macrocode}
\ProvidesExplPackage{semantic-markup}{2026-08-27}{0.2.0}
  {Semantic markup macros for LaTeX (LSM)}
\RequirePackage{xparse}
\RequirePackage{mathrsfs}
\RequirePackage{bm}
\RequirePackage{amssymb}
\RequirePackage{l3keys2e}
% \end{macrocode}
%
% \subsection{Public commands}
%
% Every user-level command is declared once, unconditionally, here.
% None of them change between styles: each is a fixed, thin wrapper
% around an internal presentation-hook function of the same shape,
% and it is only those internal functions that a style reassigns
% (\S\ref{sec:style-switching} above; \S\ref{sec:style-impl} below).
% \begin{macro}{\semName, \catName, \catSeqName, \objName, \morphName,
%   \morphSeqName, \morphMono, \morphEpi, \morphCompose,
%   \morphComposeHead, \morphComposeTail, \chartName, \atlasName,
%   \coordName}
% \begin{macrocode}
\NewDocumentCommand \semName { m } { \lsm_sem_name:n {#1} }
\NewDocumentCommand \catName { m } { \lsm_cat_name:n {#1} }
\NewDocumentCommand \catSeqName { m } { \lsm_cat_seqname:n {#1} }
\NewDocumentCommand \objName { m } { \lsm_obj_name:n {#1} }
\NewDocumentCommand \morphName { m } { \lsm_morph_name:n {#1} }
\NewDocumentCommand \morphSeqName { m } { \lsm_morph_seqname:n {#1} }
\NewDocumentCommand \morphMono { } { \lsm_morph_mono: }
\NewDocumentCommand \morphEpi { } { \lsm_morph_epi: }
\NewDocumentCommand \morphCompose { O{} } { \lsm_morph_compose:n {#1} }
\NewDocumentCommand \morphComposeHead { O{} }
  { \lsm_morph_compose_head:n {#1} }
\NewDocumentCommand \morphComposeTail { O{} }
  { \lsm_morph_compose_tail:n {#1} }
\NewDocumentCommand \chartName { m } { \lsm_chart_name:n {#1} }
\NewDocumentCommand \atlasName { m } { \lsm_atlas_name:n {#1} }
\NewDocumentCommand \coordName { m } { \lsm_coord_name:n {#1} }
% \end{macrocode}
% \end{macro}
%
% \subsection{Style implementations}
% \label{sec:style-impl}
%
% Each style is one function that reassigns \emph{every} presentation
% hook in the package via \cs{cs_set_protected:Npn} (not
% \cs{cs_new_protected:Npn}: styles overwrite, they do not merely
% declare, and no pre-existence check is wanted since more than one
% style will assign the same hook name). A style is applied by
% calling its function, never by patching individual hooks.
%
% \begin{macro}{\lsm_style_default:}
% The \texttt{default} style: the presentation choices justified,
% macro by macro, in the documentation above.
% \begin{macrocode}
\cs_new_protected:Npn \lsm_style_default:
  {
    \cs_set_protected:Npn \lsm_sem_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_cat_name:n ##1
      {
        \tl_if_single:nTF {##1}
          { \mathscr{##1} }
          { \mathbf{##1} }
      }
    \cs_set_protected:Npn \lsm_cat_seqname:n ##1 { \bm{\mathscr{##1}} }
    \cs_set_protected:Npn \lsm_obj_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_morph_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_morph_seqname:n ##1 { \bm{##1} }
    \cs_set_protected:Npn \lsm_morph_mono: { \hookrightarrow }
    \cs_set_protected:Npn \lsm_morph_epi: { \twoheadrightarrow }
    \cs_set_protected:Npn \lsm_morph_compose:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\circ} }
          { \mathbin{\overset{##1}{\circ}} }
      }
    \cs_set_protected:Npn \lsm_morph_compose_head:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\odot} }
          { \mathbin{\overset{##1}{\odot}} }
      }
    \cs_set_protected:Npn \lsm_morph_compose_tail:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\cdot} }
          { \mathbin{\overset{##1}{\cdot}} }
      }
    \cs_set_protected:Npn \lsm_chart_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_atlas_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_coord_name:n ##1 { ##1 }
  }
% \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lsm_style_plain:}
% The \texttt{plain} style: every \texttt{*Name} family macro
% unstyled; mono/epi/compose glyphs unchanged from \texttt{default}
% (see the documentation above for why). Demonstrates that a style is
% a real, independent, complete bundle, not a variant of
% \cs{lsm_style_default:}.
% \begin{macrocode}
\cs_new_protected:Npn \lsm_style_plain:
  {
    \cs_set_protected:Npn \lsm_sem_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_cat_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_cat_seqname:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_obj_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_morph_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_morph_seqname:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_morph_mono: { \hookrightarrow }
    \cs_set_protected:Npn \lsm_morph_epi: { \twoheadrightarrow }
    \cs_set_protected:Npn \lsm_morph_compose:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\circ} }
          { \mathbin{\overset{##1}{\circ}} }
      }
    \cs_set_protected:Npn \lsm_morph_compose_head:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\odot} }
          { \mathbin{\overset{##1}{\odot}} }
      }
    \cs_set_protected:Npn \lsm_morph_compose_tail:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\cdot} }
          { \mathbin{\overset{##1}{\cdot}} }
      }
    \cs_set_protected:Npn \lsm_chart_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_atlas_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_coord_name:n ##1 { ##1 }
  }
% \end{macrocode}
% \end{macro}
%
% \subsection{Package options and runtime setup}
%
% \begin{macro}{style}
% A single \texttt{.choice:} key in the \texttt{lsm} key family,
% defaulting to \texttt{default} via \texttt{.initial:n} (which runs
% immediately at definition time, so the package works correctly with
% no options given at all), then re-applied if the author gives an
% explicit \texttt{style=...} package option, or calls
% \cs{setupsemanticmarkup} (below) at any later point.
% \begin{macrocode}
\keys_define:nn { lsm }
  {
    style .choice: ,
    style / default .code:n = { \lsm_style_default: } ,
    style / plain .code:n = { \lsm_style_plain: } ,
    style .initial:n = default ,
  }
\ProcessKeysPackageOptions { lsm }
% \end{macrocode}
% \end{macro}
%
% \begin{macro}{\setupsemanticmarkup}
% Runtime counterpart to the package option above, matching the
% source papers' own \cs{setupquant}/\cs{setupset} precedent
% (documented above): a thin wrapper around \cs{keys_set:nn} on the
% same key family, callable anywhere in the document body, not only
% on the \cs{usepackage} line.
% \begin{macrocode}
\NewDocumentCommand \setupsemanticmarkup { m }
  { \keys_set:nn { lsm } {#1} }
% \end{macrocode}
% \end{macro}
%
%</package>
% \end{implementation}
%
% \PrintIndex
