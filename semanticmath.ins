This material is subject to the MIT License. See the LICENSE file
in the root of the source distribution, or
<https://github.com/shmuelmetz/LaTeX-Semantic-Markup>.

\endpreamble

\generate{
  \file{semanticmath.sty}{\from{semanticmath.dtx}{package}}
}

\obeyspaces
\Msg{****************************************************************}
\Msg{*}
\Msg{* semanticmath.sty extracted successfully.}
\Msg{*}
\Msg{* To install system-wide, move semanticmath.sty into a}
\Msg{* directory TeX can find, e.g.}
\Msg{*   TEXMFHOME/tex/latex/semanticmath/}
\Msg{* then run mktexlsr / initexmf --update-fndb as appropriate.}
\Msg{*}
\Msg{****************************************************************}

\endbatchfile
