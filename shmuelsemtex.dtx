% \subsection{Font packages: load only if genuinely needed}
% \label{sec:font-guard}
%
% \cs{mathscr} (needed by \cs{catName}\slash \cs{catSeqName}) and
% \cs{twoheadrightarrow}\slash \cs{rightarrowtail} (needed by \cs{morphEpi}/
% \cs{morphMono} respectively) are what this package actually uses
% from \pkg{mathrsfs}/\pkg{amssymb}. Checking either one of
% \cs{twoheadrightarrow}\slash \cs{rightarrowtail} is enough to guard both,
% since both are amssymb-only symbols (neither is defined by
% \pkg{amsmath} alone) that any font package providing one of them is
% overwhelmingly likely to also provide the other. Requiring both
% packages unconditionally breaks documents that already use a
% comprehensive math font package: \pkg{stix2}, for example, already
% defines both \cs{mathscr} and \cs{twoheadrightarrow}, and loading
% \pkg{amsfonts} (pulled in by \pkg{amssymb}) on top of it exceeds
% LaTeX's limit on symbol fonts (``Too many symbol fonts declared'').
% Guarded with \cs{ifdefined} (a plain \TeX{}
% primitive, unaffected by this file's own \pkg{expl3} catcode regime)
% so a paper that already has an equivalent font package never pays
% for these two a second time.
%    \begin{macrocode}
\ifdefined\mathscr\else\RequirePackage{mathrsfs}\fi
\ifdefined\twoheadrightarrow\else\RequirePackage{amssymb}\fi
%    \end{macrocode}
%
% \subsection{Internal variables}
%
% \begin{variable}[no-user-doc]{\l_lsm_str_tl, \l_lsm_upper_tl}
% Scratch variables used by \cs{lsm_if_arbitrary_symbol:nTF} (below)
% to hold an argument's detokenized string and its uppercased form,
% for comparison.
%    \begin{macrocode}
\tl_new:N \l_lsm_str_tl
\tl_new:N \l_lsm_upper_tl
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}[no-user-doc]{\lsm_if_arbitrary_symbol:nTF}
% Shared classification test behind \cs{catName}'s and
% \cs{morphName}\slash \cs{morphSeqName}'s auto-detection
% (\pagecrefn{sec:style-impl}): is \texttt{\#1} an \emph{arbitrary symbol}
% (an ordinary bare-symbol name, however decorated) as opposed to a
% genuine multi-letter \emph{word}? (\pagecrefn{sec:cat-symbols}):
% true if the argument contains \texttt{\^{}} or \texttt{\_{}} (a
% sub/superscript decoration, regardless of what the decoration itself
% contains), or is a single token, or consists entirely of upper-case
% letters; false otherwise. A hand-written manual conditional (not
% declared via \cs{prg_new_conditional:Npnn}, which would need a
% \texttt{p} outcome this test never requires) since its branches are
% used exactly like an ordinary \texttt{TF} conditional's.
%    \begin{macrocode}
\cs_new_protected:Npn \lsm_if_arbitrary_symbol:nTF #1#2#3
  {
    \str_if_in:nnTF {#1} { ^ }
      {#2}
      {
        \str_if_in:nnTF {#1} { _ }
          {#2}
          {
            \tl_if_single:nTF {#1}
              {#2}
              {
                \tl_set:Nx \l_lsm_str_tl { \tl_to_str:n {#1} }
                \tl_set:Nx \l_lsm_upper_tl
                  { \str_uppercase:f { \tl_to_str:n {#1} } }
                \tl_if_eq:NNTF \l_lsm_str_tl \l_lsm_upper_tl
                  {#2}
                  {#3}
              }
          }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Public commands}
%
% Every user-level command is declared once, unconditionally, here.
% None of them change between styles: each is a fixed, thin wrapper
% around an internal presentation-hook function of the same shape,
% and it is only those internal functions that a style reassigns
% (\pagecrefn{sec:style-switching} above; \pagecrefn{sec:style-impl} below).
% \begin{macro}{\semName, \catName, \catSeqName, \objName, \morphName,
%   \morphSeqName, \morphMono, \morphEpi, \morphCompose,
%   \morphComposeHead, \morphComposeTail, \morphId, \morphSeqId,
%   \morphIncl, \morphSeqIncl, \morphInclArrow, \chartName, \atlasName,
%   \coordName}
% \cs{morphIncl} and \cs{morphSeqIncl} split their optional comma list
% into the included object and the containing object before calling
% their hooks; more than two items is an error.
%    \begin{macrocode}
\NewDocumentCommand \semName { m } { \lsm_sem_name:n {#1} }
\NewDocumentCommand \catName { m } { \lsm_cat_name:n {#1} }
\NewDocumentCommand \catSeqName { m } { \lsm_cat_seqname:n {#1} }
\NewDocumentCommand \objName { m } { \lsm_obj_name:n {#1} }
\NewDocumentCommand \morphName { m } { \lsm_morph_name:n {#1} }
\NewDocumentCommand \morphSeqName { m } { \lsm_morph_seqname:n {#1} }
\NewDocumentCommand \morphMono { } { \lsm_morph_mono: }
\NewDocumentCommand \morphEpi { } { \lsm_morph_epi: }
\NewDocumentCommand \morphCompose { O{} } { \lsm_morph_compose:n {#1} }
\NewDocumentCommand \morphComposeHead { O{} }
  { \lsm_morph_compose_head:n {#1} }
\NewDocumentCommand \morphComposeTail { O{} }
  { \lsm_morph_compose_tail:n {#1} }
\NewDocumentCommand \morphId { O{} } { \lsm_morph_id:n {#1} }
\NewDocumentCommand \morphSeqId { O{} } { \lsm_morph_seqid:n {#1} }
\NewDocumentCommand \morphIncl { O{} }
  { \lsm_incl_split:Nnn \lsm_morph_incl:nn { morphIncl } {#1} }
\NewDocumentCommand \morphSeqIncl { O{} }
  { \lsm_incl_split:Nnn \lsm_morph_seqincl:nn { morphSeqIncl } {#1} }
\NewDocumentCommand \morphInclArrow { } { \lsm_morph_incl_arrow: }

\clist_new:N \l_lsm_incl_tmp_clist
\msg_new:nnn { shmuelsemtex } { incl-items }
  { More~than~two~items~for~\c_backslash_str #1:~[#2] }
\cs_new_protected:Npn \lsm_incl_split:Nnn #1 #2 #3
  {
    \clist_set:Nn \l_lsm_incl_tmp_clist {#3}
    \int_case:nnF { \clist_count:N \l_lsm_incl_tmp_clist }
      {
        { 0 } { #1 { } { } }
        { 1 }
          {
            \exp_args:Ne #1
              { \clist_item:Nn \l_lsm_incl_tmp_clist { 1 } } { }
          }
        { 2 }
          {
            \exp_args:Nee #1
              { \clist_item:Nn \l_lsm_incl_tmp_clist { 1 } }
              { \clist_item:Nn \l_lsm_incl_tmp_clist { 2 } }
          }
      }
      {
        \msg_error:nnnn { shmuelsemtex } { incl-items } {#2} {#3}
      }
  }
\NewDocumentCommand \chartName { m } { \lsm_chart_name:n {#1} }
\NewDocumentCommand \atlasName { m } { \lsm_atlas_name:n {#1} }
\NewDocumentCommand \coordName { m } { \lsm_coord_name:n {#1} }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Style implementations}
% \label{sec:style-impl}
%
% Each style is one function that reassigns \emph{every} presentation
% hook in the package via \cs{cs_set_protected:Npn} (not
% \cs{cs_new_protected:Npn}: styles overwrite, they do not merely
% declare, and no pre-existence check is wanted since more than one
% style will assign the same hook name). A style is applied by
% calling its function, never by patching individual hooks.
%
% \begin{macro}[no-user-doc]{\lsm_style_default:}
% The \texttt{default} style: the presentation choices justified,
% macro by macro, in the documentation above.
%    \begin{macrocode}
\cs_new_protected:Npn \lsm_style_default:
  {
    \cs_set_protected:Npn \lsm_sem_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_cat_name:n ##1
      {
        \lsm_if_arbitrary_symbol:nTF {##1}
          { \mathscr{##1} }
          { \mathbf{##1} }
      }
    \cs_set_protected:Npn \lsm_cat_seqname:n ##1 { \bm{\mathscr{##1}} }
    \cs_set_protected:Npn \lsm_obj_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_morph_name:n ##1
      {
        \lsm_if_arbitrary_symbol:nTF {##1}
          { \mathit{##1} }
          { \mathrm{##1} }
      }
    \cs_set_protected:Npn \lsm_morph_seqname:n ##1
      {
        \lsm_if_arbitrary_symbol:nTF {##1}
          { \bm{\mathit{##1}} }
          { \bm{\mathrm{##1}} }
      }
    \cs_set_protected:Npn \lsm_morph_mono: { \rightarrowtail }
    \cs_set_protected:Npn \lsm_morph_epi: { \twoheadrightarrow }
    \cs_set_protected:Npn \lsm_morph_compose:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\circ} }
          { \mathbin{\overset{##1}{\circ}} }
      }
    \cs_set_protected:Npn \lsm_morph_compose_head:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\odot} }
          { \mathbin{\overset{##1}{\odot}} }
      }
    \cs_set_protected:Npn \lsm_morph_compose_tail:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\cdot} }
          { \mathbin{\overset{##1}{\cdot}} }
      }
    \lsm_style_id_incl:
    \cs_set_protected:Npn \lsm_chart_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_atlas_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_coord_name:n ##1 { ##1 }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[no-user-doc]{\lsm_style_id_incl:}
% The identity and inclusion hooks, shared by both built-in styles:
% upright Id, bold for a sequence, with the identity's object as a
% subscript and an inclusion's included and containing objects as
% superscript and subscript; the inclusion arrow is a hook arrow.
% Identity and inclusion are separate hooks even where, as here, they
% render alike, so that a style can tell them apart.
%    \begin{macrocode}
\cs_new_protected:Npn \lsm_id_incl:nnn #1 #2 #3
  {
    \operatorname{#1}
    \tl_if_empty:nF {#2} { \sp {#2} }
    \tl_if_empty:nF {#3} { \sb {#3} }
  }
\cs_new_protected:Npn \lsm_style_id_incl:
  {
    \cs_set_protected:Npn \lsm_morph_id:n ##1
      { \lsm_id_incl:nnn { Id } { } {##1} }
    \cs_set_protected:Npn \lsm_morph_seqid:n ##1
      { \lsm_id_incl:nnn { \mathbf{Id} } { } {##1} }
    \cs_set_protected:Npn \lsm_morph_incl:nn ##1 ##2
      { \lsm_id_incl:nnn { Id } {##1} {##2} }
    \cs_set_protected:Npn \lsm_morph_seqincl:nn ##1 ##2
      { \lsm_id_incl:nnn { \mathbf{Id} } {##1} {##2} }
    \cs_set_protected:Npn \lsm_morph_incl_arrow: { \hookrightarrow }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[no-user-doc]{\lsm_style_plain:}
% The \texttt{plain} style: every \texttt{*Name} family macro
% unstyled; mono/epi/compose glyphs unchanged from \texttt{default}
% (see the documentation above for why). Demonstrates that a style is
% a real, independent, complete bundle, not a variant of
% \cs{lsm_style_default:}.
%    \begin{macrocode}
\cs_new_protected:Npn \lsm_style_plain:
  {
    \cs_set_protected:Npn \lsm_sem_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_cat_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_cat_seqname:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_obj_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_morph_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_morph_seqname:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_morph_mono: { \rightarrowtail }
    \cs_set_protected:Npn \lsm_morph_epi: { \twoheadrightarrow }
    \cs_set_protected:Npn \lsm_morph_compose:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\circ} }
          { \mathbin{\overset{##1}{\circ}} }
      }
    \cs_set_protected:Npn \lsm_morph_compose_head:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\odot} }
          { \mathbin{\overset{##1}{\odot}} }
      }
    \cs_set_protected:Npn \lsm_morph_compose_tail:n ##1
      {
        \tl_if_empty:nTF {##1}
          { \mathbin{\cdot} }
          { \mathbin{\overset{##1}{\cdot}} }
      }
    \lsm_style_id_incl:
    \cs_set_protected:Npn \lsm_chart_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_atlas_name:n ##1 { ##1 }
    \cs_set_protected:Npn \lsm_coord_name:n ##1 { ##1 }
  }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Package options and runtime setup}
%
% \begin{macro}{style}
% A single \texttt{.choice:} key in the \texttt{lsm} key family,
% defaulting to \texttt{default} via \texttt{.initial:n} (which runs
% immediately at definition time, so the package works correctly with
% no options given at all), then re-applied if the author gives an
% explicit \texttt{style=...} package option, or calls
% \cs{setupsemanticmarkup} (below) at any later point.
%    \begin{macrocode}
\keys_define:nn { lsm }
  {
    style .choice: ,
    style / default .code:n = { \lsm_style_default: } ,
    style / plain .code:n = { \lsm_style_plain: } ,
    style .initial:n = default ,
  }
\ProcessKeysPackageOptions { lsm }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\setupsemanticmarkup}
% Runtime counterpart to the package option above, matching the
% source papers' own \cs{setupquant}\slash \cs{setupset} precedent
% (documented above): a thin wrapper around \cs{keys_set:nn} on the
% same key family, callable anywhere in the document body, not only
% on the \cs{usepackage} line.
%    \begin{macrocode}
\NewDocumentCommand \setupsemanticmarkup { m }
  { \keys_set:nn { lsm } {#1} }
%    \end{macrocode}
% \end{macro}
%
% \subsection{Quantifiers, sets, and underset-variant renderers}
% \label{sec:quant-set-impl}
%
% The public interface of these commands (\cs{equant}, \cs{uquant},
% \cs{set}, \cs{setupquant}, \cs{setupset}, \cs{union},
% \cs{intersection}, \cs{full}, \cs{maxfull}, \cs{maximal},
% \cs{strict}, \cs{Triv}, \cs{seqname}) is the one the source papers
% use; \cs{setupquant} and \cs{setupset} are the model for
% \cs{setupsemanticmarkup} (see the discussion in
% \pagecrefn{sec:style-impl}). Each macro family has its own scoped,
% uniquely named scratch variables, so one family nested inside
% another's argument (e.g.\ a \cs{union} inside a \cs{set} predicate)
% is safe.
%
% \begin{variable}[no-user-doc]{\l_lsm_quant_tmp_clist, \l_lsm_quant_tmp_fp,
%   \l_lsm_set_tmp_clist, \l_lsm_set_tmp_tl, \l_lsm_set_star_bool,
%   \l_lsm_unint_tmp_clist, \l_lsm_unint_tmp_fp, \l_lsm_full_tmp_tl,
%   \l_lsm_maximal_tmp_tl, \l_lsm_strict_tmp_tl}
% Each macro family below gets its own uniquely-named scratch
% variables, declared together here rather than reusing a shared
% \texttt{tmpa}-style name across families -- the fix for the latent
% nesting bug described above.
%    \begin{macrocode}
\clist_new:N \l_lsm_quant_tmp_clist
\fp_new:N    \l_lsm_quant_tmp_fp
\clist_new:N \l_lsm_set_tmp_clist
\tl_new:N    \l_lsm_set_tmp_tl
\bool_new:N  \l_lsm_set_star_bool
\clist_new:N \l_lsm_unint_tmp_clist
\fp_new:N    \l_lsm_unint_tmp_fp
\tl_new:N    \l_lsm_full_tmp_tl
\tl_new:N    \l_lsm_maximal_tmp_tl
\tl_new:N    \l_lsm_strict_tmp_tl
%    \end{macrocode}
% \end{variable}
%
% \begin{macro}{\equant, \uquant, \setupquant}
% Existential/universal quantifier rendering, with a runtime style
% switch (parenthesization and subscript-vs-inline placement of the
% bound variables) via \cs{setupquant}, independent of
% \cs{setupsemanticmarkup} above -- this is the papers' own original
% style mechanism, kept as its own key family rather than folded into
% \texttt{lsm}'s, since it predates and is unrelated to the
% default/plain style choice.
%    \begin{macrocode}
\int_new:N \g_lsm_quant_parens_int
\int_new:N \g_lsm_quant_subscr_int
\tl_new:N \g_lsm_quant_sep_tl

\NewDocumentCommand{\equant}{mm}
  { \lsm_quant:nnn {\exists} {#1} {#2} }

\NewDocumentCommand{\uquant}{mm}
  { \lsm_quant:nnn {\forall} {#1} {#2} }

\NewDocumentCommand \setupquant {m}
  { \keys_set:nn {lsm-quant} {#1} }

\keys_define:nn {lsm-quant}
 {
  subscript   .choices:nn =
    {
      {none, stacked, multiple}
      { \int_gset:Nn \g_lsm_quant_subscr_int {\l_keys_choice_int - 1} }
    },
  subscript   .default:n = multiple,
  subscript   .initial:n = none,
  parentheses .choices:nn =
    {
      {none, single, multiple}
      { \int_gset:Nn \g_lsm_quant_parens_int {\l_keys_choice_int - 1} }
    },
  parentheses .default:n = multiple,
  parentheses .initial:n = none,
  separator   .tl_set:N  = \g_lsm_quant_sep_tl,
  separator   .default:n = {.},
  separator   .initial:n = {},
 }

\cs_new_protected:Npn \lsm_quant:nnn #1 #2 #3
  {
    \clist_set:Nn \l_lsm_quant_tmp_clist {#2}
    \int_case:nn {\g_lsm_quant_subscr_int}
      {
        {0}
        {
          \int_compare:nT {\g_lsm_quant_parens_int > 0} {\left (}
          #1
          \clist_use:Nn \l_lsm_quant_tmp_clist {\g_lsm_quant_sep_tl}
          \int_compare:nT {\g_lsm_quant_parens_int > 0} {\right )}
          \g_lsm_quant_sep_tl #3
        }
        {1}
        {
          \fp_set:Nn \l_lsm_quant_tmp_fp
            {ceil{\clist_count:N \l_lsm_quant_tmp_clist - 1} * .1 + 1}
          \int_compare:nT {\g_lsm_quant_parens_int > 0} {\left (}
          \scaleobj{\fp_to_decimal:N \l_lsm_quant_tmp_fp}{#1} \sb
            { \substack { \clist_use:Nn \l_lsm_quant_tmp_clist { \\ } } }
          \int_compare:nT {\g_lsm_quant_parens_int > 0} {\right )}
          #3
        }
        {2}
        {
          \int_compare:nT {\g_lsm_quant_parens_int = 1} {\left (}
          \clist_map_inline:Nn \l_lsm_quant_tmp_clist
            {
              \int_compare:nT {\g_lsm_quant_parens_int = 2} {\left (}
              \scaleobj{1.2}{#1} \sb {##1}
              \int_compare:nT {\g_lsm_quant_parens_int = 2} {\right )}
            }
          \int_compare:nT {\g_lsm_quant_parens_int = 1} {\right )}
          #3
        }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\set, \setupset}
% Set-builder notation, \cs{set}\marg{elements}\oarg{propositions},
% with an optional star after the arguments
% (\cs{set}\marg{elements}\oarg{propositions}\texttt{*}) that splits the
% line between elements and propositions -- useful inside a
% \env{multline} environment, since \LaTeX{} cannot otherwise break a
% line inside a macro argument. \cs{setupset}'s \texttt{separator} key
% sets the symbol between elements and propositions; its
% \texttt{subscript} key applies to \cs{union} and \cs{intersection}
% (below).
%    \begin{macrocode}
\tl_new:N \g_lsm_set_sep_tl
\int_new:N \g_lsm_set_subscr_int

\NewDocumentCommand{\set}{mos}
  {
    \IfBooleanTF {#3}
      { \bool_set_true:N  \l_lsm_set_star_bool }
      { \bool_set_false:N \l_lsm_set_star_bool }
    \lsm_set_of:nnn {#1} {#2} {\l_lsm_set_star_bool}
  }

\NewDocumentCommand \setupset {m}
  { \keys_set:nn {lsm-set} {#1} }

\keys_define:nn {lsm-set}
  {
    separator .tl_set:N  = \g_lsm_set_sep_tl,
    separator .initial:n = {\mid},
    subscript .choices:nn =
      {
        {stacked, multiple}
        { \int_gset:Nn \g_lsm_set_subscr_int {\l_keys_choice_int - 1} }
      },
    subscript .initial:n = stacked,
  }

\cs_new_protected:Npn \lsm_set_of:nnn #1 #2 #3
  {
    \IfValueTF {#2}
      {
        \clist_set:Nn \l_lsm_set_tmp_clist {#2}
        \tl_set:Nx \l_lsm_set_tmp_tl
          { \clist_use:Nn \l_lsm_set_tmp_clist {\land} }
        \bool_if:nTF {#3}
          {
            \scalerel*{\{}{#1 \l_lsm_set_tmp_tl}
            #1
            \clist_set:Nn \l_lsm_set_tmp_clist {#2}
            \scalerel*{\mathbin{\g_lsm_set_sep_tl}}{#1 \l_lsm_set_tmp_tl}
            \\
            \clist_set:Nn \l_lsm_set_tmp_clist {#2}
            \l_lsm_set_tmp_tl
            \clist_set:Nn \l_lsm_set_tmp_clist {#2}
            \scalerel*{\}}{#1 \l_lsm_set_tmp_tl}
          }
          {
            \left \{
            #1
            \clist_set:Nn \l_lsm_set_tmp_clist {#2}
            \scalerel*{\mathbin{\g_lsm_set_sep_tl}}{#1 \l_lsm_set_tmp_tl}
            \l_lsm_set_tmp_tl
            \right \}
          }
      }
      { \left \{ #1 \right \} }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\union, \intersection}
% \cs{union}\oarg{indices}\marg{set} and
% \cs{intersection}\oarg{indices}\marg{set} typeset indexed union and intersection; the index list's subscript
% placement (stacked under the operator, or inline comma-separated) is
% controlled by \cs{setupset}'s \texttt{subscript} key above, shared
% with \cs{set} since both are the same family of indexed-operator
% notation.
%    \begin{macrocode}
\NewDocumentCommand{\intersection}{om}
  { \lsm_unint_of:nnn \bigcap {#1} {#2} }

\NewDocumentCommand{\union}{om}
  { \lsm_unint_of:nnn \bigcup {#1} {#2} }

\cs_new_protected:Npn \lsm_unint_of:nnn #1 #2 #3
  {
    \IfValueTF {#2}
      {
        \clist_set:Nn \l_lsm_unint_tmp_clist {#2}
        \int_case:nn {\g_lsm_set_subscr_int}
          {
            {0}
            {
              \fp_set:Nn \l_lsm_unint_tmp_fp
                {ceil{\clist_count:N \l_lsm_unint_tmp_clist - 1} * .1 + 1}
              \scaleobj{\fp_to_decimal:N \l_lsm_unint_tmp_fp}{#1} \sb
                { \substack { \clist_use:Nn \l_lsm_unint_tmp_clist { \\ } } }
              #3
            }
            {1}
            {
              #1 \sb {\clist_use:Nn \l_lsm_unint_tmp_clist {,}}
              #3
            }
          }
      }
      { #1 #3 }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\full, \maxfull, \maximal, \strict, \Triv}
% A family of underset-variant renderers: each takes an optional
% \meta{qualifiers} argument (bare, \texttt{*}, \texttt{**}, or text
% ending in a literal \texttt{-}, meaning ``compose this argument onto
% the underset text'') and typesets \texttt{\#2} with a small label
% underneath, upright (\cs{textup}) except for \cs{Triv}'s bold
% \texttt{triv}, indicating a variation of ``full''/``max or
% full''/``max''/``strict''/``triv'' respectively.
%    \begin{macrocode}
\NewDocumentCommand{\full}{O{full} m}
  { \lsm_show_full:nn {#1} {#2} }

\cs_new_protected:Npn \lsm_show_full:nn #1 #2
  {
    \tl_set:Nn \l_lsm_full_tmp_tl {#1}
    \str_if_eq:eeTF {\str_item:nn {#1} {-1}} {-}
      { \tl_set:Nx \l_lsm_full_tmp_tl {{#1}full} }
      {
        \str_case:nn {#1}
          {
            {*}  {\tl_set:Nn \l_lsm_full_tmp_tl {(full,S-max-full,max-full)}}
            {**} {\tl_set:Nn \l_lsm_full_tmp_tl {full~(S-max-full,max-full)}}
          }
      }
    \underset {\textup{\l_lsm_full_tmp_tl}} {#2}
  }

\NewDocumentCommand{\maxfull}{O{max-full} m}
  {
    \lsm_maximal:nnnnnnn {max-full} {#1} {#2}
      {full,max,max-full} {full,max}
      {full~(max,max-full)} {full~(max)}
  }

\NewDocumentCommand{\maximal}{O{max} m}
  { \lsm_maximal:nnnnnnn {max} {#1} {#2} {max} {} {max} {} }

\cs_new_protected:Npn \lsm_maximal:nnnnnnn #1 #2 #3 #4 #5 #6 #7
  {
    \tl_set:Nn \l_lsm_maximal_tmp_tl {#2}
    \str_if_eq:eeTF {\str_item:nn {#2} {-1}} {-}
      { \tl_set:Nx \l_lsm_maximal_tmp_tl {{#2}#1} }
      {
        \str_case:nn {#2}
          {
            {*}   {\tl_set:Nn \l_lsm_maximal_tmp_tl {(#4)}}
            {*x}  {\tl_set:Nn \l_lsm_maximal_tmp_tl {(#5)}}
            {**}  {\tl_set:Nn \l_lsm_maximal_tmp_tl {#6}}
            {**x} {\tl_set:Nn \l_lsm_maximal_tmp_tl {#7}}
          }
      }
    \underset {\textup{\l_lsm_maximal_tmp_tl}} {#3}
  }

\NewDocumentCommand{\strict}{O{strict} m}
  { \lsm_show_strict:nn {#1} {#2} }

\cs_new_protected:Npn \lsm_show_strict:nn #1 #2
  {
    \tl_set:Nn \l_lsm_strict_tmp_tl {#1}
    \str_if_eq:eeTF {\str_item:nn {#1} {-1}} {-}
      { \tl_set:Nx \l_lsm_strict_tmp_tl {{#1}strict} }
      {
        \str_case:nn {#1}
          {
            {*}  {\tl_set:Nn \l_lsm_strict_tmp_tl {(semi-strict,strict)}}
            {**} {\tl_set:Nn \l_lsm_strict_tmp_tl {semi-strict~(strict)}}
          }
      }
    \underset {\textup{\l_lsm_strict_tmp_tl}} {#2}
  }

\NewDocumentCommand{\Triv}{o m}
  { \lsm_triv:nn {#1} {#2} }

\cs_new_protected:Npn \lsm_triv:nn #1 #2
  {
    \IfValueTF {#1}
      {
        \str_case:nnF {#1}
          {
            {full-submod-} {\underset{\mathbf{{#1}triv}}{#2}}
            {full-}        {\underset{\mathbf{{#1}triv}}{#2}}
            {submod-}      {\underset{\mathbf{{#1}triv}}{#2}}
          }
          { {\underset{#1\mathbf{triv}}{#2}} }
      }
      { {\underset{\mathbf{triv}}{#2}} }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\seqname}
% Render a sequence/set/tuple name: bold upright for a multi-character
% name, bold italic for a single character -- the same
% length-based split \cs{catName} uses, kept as its own macro since it
% is semantically a different kind of object (a sequence, not a
% category) even though the rendering rule happens to coincide.
%    \begin{macrocode}
\NewDocumentCommand{\seqname}{m}
  { \lsm_seqname:n {#1} }

\cs_new_protected:Npn \lsm_seqname:n #1
  {
    \int_compare:nTF {\tl_count:n {#1} > 1}
      { {\mathbf{#1}} }
      {
        \cs_if_exist:NTF \mathbfit
          { {\mathbfit{#1}} }
          { {\bm{\mathit{#1}}} }
      }
  }
%    \end{macrocode}
% \end{macro}
%
%</package>
% \end{implementation}
%
% \PrintIndex
