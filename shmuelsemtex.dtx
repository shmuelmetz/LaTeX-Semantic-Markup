% The keys:
% \begin{description}
% \item[\texttt{separator}] The symbol between the elements and the
%   propositions of \cs{set}; initially $\mid$.
% \item[\texttt{subscript}] Placement of the indices of \cs{union} and
%   \cs{intersection}: \texttt{stacked} (initial), stacked under an
%   enlarged operator; \texttt{multiple}, a comma-separated subscript.
% \end{description}
% \end{function}
