% \section{Purpose}
% \label{sec:purpose}
%
% This package provides macros that record the \emph{semantic role}
% of a piece of mathematical text --- ``this is the display name of a
% category,'' ``this is a monomorphism arrow'' --- separately from
% how that role is \emph{typeset}. An author writing
% \cs{catName}\Arg{C} is not choosing a font; they are asserting that
% \texttt{C} names a category, and the package decides what a
% category name looks like.
%
% The category-theory naming layer above (\cs{catName}, \cs{morphName},
% \cs{morphMono}\slash \cs{morphEpi}, etc.) is only part of the package.
% Quantifiers (\cs{equant}\slash \cs{uquant}) and set-builder notation
% (\cs{set}\slash \cs{union}\slash \cs{intersection}), documented in
% \pagecrefn{sec:quant-set} below, are general first-order-logic and
% set-theory constructs, not specific to category theory, and are
% equally usable in any mathematical document.
%
% \begin{quote}
% \textbf{Design goal:} a paper submitted to different journals should
% not need different markup for their different house styles, only
% different setup. Concretely:
% \cs{catName}\Arg{Set} (or any semantic macro, anywhere in the
% document body) must be byte-for-byte identical whether the target
% is arXiv, journal~X's house style, or journal~Y's house style. Only
% \emph{setup} may differ: the \texttt{style} package option and the
% setup commands \cs{setupsemanticmarkup} (see
% \pagecrefn{sec:style-switching}), \cs{setupquant} and \cs{setupset} (see
% \pagecrefn{sec:quant-set}) --- never the markup at the use sites.
%
% This is not just an API-ergonomics nicety; it is the whole point of
% the package, and it generalizes the ``macros do the heavy lifting''
% principle used throughout the design decisions below into a
% concrete, checkable test:
% \textbf{the journal-portability test} --- \emph{if satisfying a
% house-style change would ever require touching the markup at the
% use sites (as opposed to setup), the design is wrong.} Every design
% question in this package, past and future, is judged against this
% test.
% \end{quote}
%
% Two consequences follow directly from the test above, and both are
% enforced throughout this package:
% \begin{enumerate}
% \item Two things that look similar on the page but mean different
%   things mathematically must not share a macro, even if that means
%   near-identical default typesetting for two commands (otherwise a
%   house style that \emph{does} want them to look different could
%   not ask for that without editing the body).
% \item One concept must not be given two names merely because it is
%   styled differently in different contexts (otherwise the author
%   would have to choose between the two names based on a
%   presentation decision, rather than on what they mean) --- and no
%   macro's presentation may be hard-coded at all: every macro's
%   actual rendering is decided by the active \emph{style}
%   (\pagecrefn{sec:style-switching}), never per use.
% \end{enumerate}
%
% \section{Background}
% \label{sec:background}
%
% The notation in this package was first written as private macros in
% two papers by its author, \emph{Local Coordinate Spaces: a proposed
% unification of manifolds with fiber bundles, and associated machinery}
% \cite{lcs} and \emph{Towards a taxonomy of atlases and of morphisms
% between them} \cite{matlas}. Those macros were refactored into this
% package, which the papers now load; \pagecrefn{sec:history} gives the
% details.
%
% \section{Internal naming}
%
% Package-internal \pkg{expl3} functions use the module prefix
% \texttt{lsm} (for \LaTeX\ Semantic Markup), per the naming
% convention \texttt{\textbackslash lsm\_}\emph{module}\texttt{\_}%
% \emph{description}\texttt{:}\emph{args}. These are not intended for
% direct use in documents.
%
% \section{Style switching}
% \label{sec:style-switching}
%
% Every semantic macro in this package (\cs{catName}, \cs{morphMono},
% \ldots) is a thin public wrapper around an internal \pkg{expl3}
% function of the same shape (\cs{lsm_cat_name:n}, \cs{lsm_morph_mono:%
% }, \ldots) that does the actual typesetting. Those internal
% functions are not fixed: each one is a \emph{presentation hook},
% (re)definable as a group, all at once, by a named \emph{style}. This
% hook architecture is not new machinery bolted on for style
% switching; it already existed, one hook per macro, from the first
% version of this package (motivated by the same
% typography/semantics separation), and style switching is built as a
% dispatch layer on top of exactly those existing hooks, rather than
% as some separate mechanism.
%
% A style is normally selected as a package option:
% \begin{verbatim}
% \usepackage[style=default]{shmuelsemtex}   % built in, default
% \usepackage[style=plain]{shmuelsemtex}     % built in, alternate
% \end{verbatim}
% and can also be changed anywhere in the document with
% \cs{setupsemanticmarkup} (below). Quantifier and set-builder
% rendering have their own setup commands, \cs{setupquant} and
% \cs{setupset} (\pagecrefn{sec:quant-set}). Either way, the markup at the
% use sites --- every \cs{catName}, every \cs{morphCompose},
% everything --- is written once and does not vary with the setup;
% moving between, say, an arXiv upload and a journal submission
% changes only the setup. This is the direct implementation of the
% journal-portability test in \pagecrefn{sec:purpose}.
%
% The mechanism is \pkg{l3keys2e} package-option processing (the
% standard modern \pkg{expl3} idiom for \texttt{key=value}
% \cs{usepackage} options; the same mechanism many CTAN packages use
% for exactly this ``pick a coherent bundle of choices at once''
% pattern), with a single \texttt{.choice:} key, \texttt{style}, in
% the key family \texttt{lsm}. Each choice's code is one function
% (\cs{lsm_style_default:}, \cs{lsm_style_plain:}) that reassigns
% \emph{every} presentation hook in the package in one place, so a
% style is always a complete, coherent bundle --- never a partial
% patch the author has to assemble by hand from individual macro
% redefinitions. \texttt{style} defaults to \texttt{default} via
% \texttt{.initial:n}, which runs the named choice's code at
% \cs{keys_define:nn} time, so the package works with no options at
% all; any explicit \texttt{style=...} package
% option is applied afterward via \cs{ProcessKeysPackageOptions}.
%
% Only two styles are built in for now, both illustrating the
% mechanism rather than encoding any real journal's house style yet:
% \begin{description}
% \item[\texttt{default}] The presentation choices already justified,
%   macro by macro, in the sections below (script/bold-upright
%   auto-detected category names, bold sequence names, tail/twohead
%   arrows for mono/epi, \ldots).
% \item[\texttt{plain}] Every \texttt{*Name} family macro
%   (\cs{semName}, \cs{catName}, \cs{catSeqName}, \cs{objName},
%   \cs{morphName}, \cs{morphSeqName}, \cs{chartName}, \cs{atlasName},
%   \cs{coordName}) renders completely unstyled, ambient math
%   typeface --- no script, no bold, no auto-detection. The
%   mono/epi arrows and the compose/compose-head/compose-tail glyphs
%   are left as in \texttt{default}: those are closer to fixed
%   mathematical convention (an arrow shape for a monomorphism,
%   distinct glyphs for three distinct composition operations) than
%   to journal-specific name typography, so a demonstration ``plain''
%   style does not touch them --- a real house-style-specific style
%   built later might, but that is a further design question, not
%   answered here.
% \end{description}
% Where no predefined style matches the house style, a new style is
% added as one more \texttt{style / \meta{name} .code:n} choice and
% one more \cs{lsm_style_\meta{name}:} function that reassigns the
% same complete set of hooks; it never means touching the public
% macros or the markup at the use sites. The package does not yet
% provide a user-level command for defining a style in a document's
% own preamble.
%
% \begin{quote}
% \textbf{Runtime setup.} \cs{setupquant} and \cs{setupset}
% (\pagecrefn{sec:quant-set}) are runtime setup commands built on plain
% \pkg{l3keys}, called once, away from every use site:
% \begin{verbatim}
% \setupquant {parentheses=multiple,subscript=stacked}
% \end{verbatim}
% after which every \cs{equant}\slash \cs{uquant} call, anywhere in the
% document, renders accordingly, unchanged at the call site. Unlike a
% package option, a runtime command can be invoked anywhere a document
% needs it, not only on the \cs{usepackage} line.
%
% The \texttt{style} key is available at runtime in the same way, via
% \cs{setupsemanticmarkup}, a thin wrapper around \cs{keys_set:nn} on
% the key family defined for the package options:
% \begin{verbatim}
% \setupsemanticmarkup {style=plain}
% \end{verbatim}
% Both forms are kept: \cs{keys_set:nn} is what
% \cs{ProcessKeysPackageOptions} calls to apply a package option, and
% \cs{setupsemanticmarkup} makes the same call available at any point
% in the body.
%
% This package's styles remain one coherent \texttt{style} bundle
% covering every macro at once, unlike \cs{setupquant}\slash \cs{setupset}'s
% split into independent per-concept-family setup commands: a
% journal's house style is ordinarily one holistic choice applied
% consistently everywhere, not an independent axis per semantic
% family the way quantifier-rendering-taste and set-builder-rendering-%
% taste are independent of each other for a single author. If a real
% future style needs finer-grained, per-family control, splitting
% \texttt{style} into per-family keys (mirroring \texttt{quant}/%
% \texttt{set} exactly) is a natural extension of this same
% \pkg{l3keys} foundation, not a different mechanism.
% \end{quote}
%
% \section{Abbreviations used in macro names}
%
% Every abbreviated word appearing in a user-level macro name is
% spelled out here, once, so no reader has to guess it from context.
% Family and role prefixes that are already complete English words
% (\texttt{chart}, \texttt{atlas}, \texttt{name}, \texttt{compose})
% are not abbreviations and are not listed.
%
% \begin{description}
% \item[\texttt{sem}] Semantic
% \item[\texttt{cat}] Category
% \item[\texttt{obj}] Object
% \item[\texttt{morph}] Morphism
% \item[\texttt{coord}] Coordinate
% \item[\texttt{seq}] Sequence (as in \cs{catSeqName}: a
%   \emph{sequence of} the preceding concept, not that concept itself)
% \item[\texttt{mono}] Monomorphism
% \item[\texttt{epi}] Epimorphism
% \end{description}
%
% \section{User-level command families}
%
% User-level commands are grouped by the semantic domain they tag,
% each using its own name prefix:
% \begin{itemize}
%   \item \texttt{sem} (Semantic) --- generic / not-yet-classified
%     semantic text
%   \item \texttt{cat} (Category) --- categories (in the
%     category-theoretic sense)
%   \item \texttt{obj} (Object) --- objects of a category
%   \item \texttt{morph} (Morphism) --- morphisms between objects
%   \item \texttt{chart} --- charts
%   \item \texttt{atlas} --- atlases of charts
%   \item \texttt{coord} (Coordinate) --- coordinate systems/functions
% \end{itemize}
% What follows documents what each macro \emph{means} and why it is
% (or is not) distinct from its neighbors --- that does not change
% with the active style. What each macro actually renders as, under
% each built-in style, is in \pagecrefn{sec:style-switching} and the
% Implementation section below.
%
% \subsection{Generic}
%
% \begin{function}{\semName}
% \begin{syntax}
% \cs{semName}\marg{text}
% \end{syntax}
% \cs{semName}\Arg{text} (Sem = Semantic) tags \texttt{text} as
% semantically significant without committing to any of the more
% specific domains below. Use this only as a placeholder until a
% more specific macro applies, or for genuinely domain-agnostic
% labels.
% \end{function}
%
% \subsection{Categories}
%
% \begin{function}{\catName}
% \begin{syntax}
% \cs{catName}\marg{text}
% \end{syntax}
% \cs{catName}\Arg{text} (Cat = Category) is the display name of a
% single category, whether an arbitrary/variable category symbol
% (e.g.\ \cs{catName}\Arg{C}) or a long, conventionally-fixed name
% (e.g.\ \cs{catName}\Arg{Set}). The author writes the same macro
% either way and never separately decides a typeface: see the
% discussion below of symbols and names for why this is
% one auto-detecting macro rather than two.
% \end{function}
%
% \begin{quote}
% \textbf{One macro for symbols and names:} a category may be written
% with an arbitrary symbol, such as \texttt{C}, or with a name, such as
% \texttt{Set} or \texttt{Top}. The difference in typeface is a
% convention about the length of the name, with no semantic distinction
% behind it. Two macros would force the author to decide a typographic
% question as a separate step from expressing what they mean.
% \cs{catName} is therefore a single macro that decides for itself: the
% author writes \cs{catName}\Arg{Set} or \cs{catName}\Arg{C}
% identically and never chooses upright vs.\ script. Under the
% \texttt{default} style an arbitrary symbol renders in script and a
% name renders bold upright, by the test in
% \pagecrefn{sec:cat-symbols}; see \pagecrefn{sec:style-switching} for
% how a different style swaps that choice as a unit, without the author
% touching \cs{catName}\Arg{Set} itself.
% \end{quote}
%
% \begin{quote}
% \label{sec:cat-symbols}
% \textbf{Symbols vs.\ names:} token count alone does not separate
% symbols from names. \texttt{C\^{}2}, \texttt{E\^{}i} and
% \texttt{XY} (a product-space category \(X \times Y\)) are arbitrary
% symbols, yet none is a single token.
% What distinguishes them from \texttt{Set}/\texttt{Top} is whether
% the argument reads as a \emph{decorated or concatenated symbol} (a
% base letter carrying a sub/superscript, or two symbol-like letters
% standing for a product) versus a genuine multi-letter \emph{word}.
% \cs{catName} tests, in order: (1) does the argument contain \texttt{\^{}} or \texttt{\_{}}
% (a sub/superscript decoration) --- if so, script, regardless of what
% the decoration itself contains (this is why \texttt{E\^{}i}'s
% lower-case \texttt{i} never has to be examined: the whole argument
% is already settled as ``decorated symbol'' by the presence of
% \texttt{\^{}} alone); (2) is it a single token --- if so, script;
% (3) is every letter in the argument already upper case ---
% if so, script (this is what catches \texttt{XY}: two upper-case
% letters standing for a product, not a lower-case-bearing word); (4)
% otherwise, bold upright.
% \end{quote}
%
% \begin{function}{\catSeqName}
% \begin{syntax}
% \cs{catSeqName}\marg{text}
% \end{syntax}
% \cs{catSeqName}\Arg{text} (Cat = Category, Seq = Sequence) is the
% display name of a \emph{sequence or family of categories}, e.g.
% $(\mathscr{A}_\alpha)_{\alpha \in A}$. This is deliberately a
% distinct command from \cs{catName}, not a styling variant of it: a
% sequence of categories is not itself a category, and collapsing the
% two into one macro differentiated only by an optional ``bold''
% switch would silently re-introduce the typography/semantics
% conflation this package exists to remove.
% \end{function}
%
% \subsection{Objects}
%
% \begin{function}{\objName}
% \begin{syntax}
% \cs{objName}\marg{text}
% \end{syntax}
% \cs{objName}\Arg{text} (Obj = Object) is the display name of an
% object of a category.
% Under the \texttt{default} style the presentation is unstyled
% (objects are typically bare math-mode variables in practice); the
% macro exists so that document text records the semantic role even
% when the current style's rendering does nothing visible.
% \end{function}
%
% \subsection{Morphisms}
%
% \begin{function}{\morphName}
% \begin{syntax}
% \cs{morphName}\marg{text}
% \end{syntax}
% \cs{morphName}\Arg{text} (Morph = Morphism) is the display
% name/label of a morphism (e.g.\ a function symbol).
% \end{function}
%
% \begin{quote}
% \textbf{A morphism vs.\ the class of all morphisms:} by
% the standard definition, a single morphism always has a specific
% source and target --- it is an element of a particular hom-set.
% That is a different notion from ``the class of all morphisms/arrows
% in a category,'' which has no reference to specific endpoints.
% \cs{morphName} (a label for one morphism, e.g.\ $f$) is already
% built around the correct, standard reading.
%
% \texttt{morphAll} (all morphisms of a category) and
% \texttt{morphBetween} (morphisms from one specific object to
% another, a hom-set) are natural names
% for these two notions but are not built here, pending a decision on
% naming.
% \end{quote}
%
% \begin{quote}
% \textbf{Function symbols vs.\ names:} \cs{morphName}\slash
% \cs{morphSeqName} use the same test as \cs{catName}
% (\pagecrefn{sec:cat-symbols}): decoration (\texttt{\^{}}/%
% \texttt{\_{}}) or single token or all-upper-case letters -> italic
% (or bold italic); otherwise -> upright (or bold upright). Single
% tokens include single \emph{control sequences} such as \cs{pi} and
% \cs{rho}, whatever the length of their names. As with
% \texttt{C\^{}2}, \texttt{f\^{}2} is an arbitrary symbol though not
% a single token: a decorated base symbol is still an arbitrary symbol,
% not a name.
% \end{quote}
%
% \begin{function}{\morphSeqName}
% \begin{syntax}
% \cs{morphSeqName}\marg{text}
% \end{syntax}
% \cs{morphSeqName}\Arg{text} (Morph = Morphism, Seq = Sequence) is
% the display name of a \emph{sequence or tuple of morphisms/%
% functions}, e.g.\ $\bm{f} \mathrel{:=} (f_1, f_2)$. Like
% \cs{catSeqName}
% vs.\ \cs{catName}, this is a genuinely distinct \pkg{expl3} function
% from \cs{morphName} (\cs{lsm_morph_seqname:n}, not
% \cs{lsm_morph_name:n} with a flag): a sequence of functions is not
% itself a function. Auto-detects the same way \cs{morphName} does,
% but bold throughout --- see the note on function symbols above.
% See the discussion
% below.
% \end{function}
%
% \begin{quote}
% \textbf{morphSeqName vs.\ morphName:} a sequence of
% functions is not a function, the same principle as the
% \cs{catSeqName}\slash \cs{catName} and compose/compose-head/compose-tail
% distinctions in this section. \cs{morphSeqName} is
% built accordingly as a genuinely
% distinct \pkg{expl3} function, \cs{lsm_morph_seqname:n}, not
% \cs{lsm_morph_name:n} called with a different flag.
% \end{quote}
%
% \begin{function}{\morphMono}
% \begin{syntax}
% \cs{morphMono}
% \end{syntax}
% \cs{morphMono} (Mono = Monomorphism) is the arrow symbol for a
% monomorphism.
% \end{function}
%
% \begin{quote}
% \textbf{Tail, not hook:} a hook ($A \hookrightarrow B$) represents
% an inclusion map. A tail ($A \rightarrowtail B$) represents a
% monomorphism. These are two distinct notions with two distinct
% symbols (every inclusion is a monomorphism, but not every
% monomorphism is an inclusion); conflating them under one glyph is
% exactly the typography/semantics conflation this package exists to
% prevent. \cs{morphMono} therefore renders as \cs{rightarrowtail}
% (↣, from \pkg{amssymb}; see \pagecrefn{sec:font-guard}), matching
% the category-theory
% convention that draws the same hook-vs-tail distinction.
% The hook arrow is \cs{morphInclArrow}.
% \end{quote}
%
% \begin{function}{\morphEpi}
% \begin{syntax}
% \cs{morphEpi}
% \end{syntax}
% \cs{morphEpi} (Epi = Epimorphism) is the arrow symbol for an
% epimorphism.
% This is kept distinct from \cs{morphMono} because mono/epi is a
% real mathematical distinction (injective vs.\ surjective in the
% relevant sense), not a choice of arrowhead glyph.
% \end{function}
%
% \begin{function}{\morphCompose}
% \begin{syntax}
% \cs{morphCompose}\oarg{label}
% \end{syntax}
% \cs{morphCompose} is the general morphism-composition operator
% (default $\circ$). An optional argument
% \cs{morphCompose}\oarg{label} places \texttt{label} over the
% operator.
% \end{function}
%
% \begin{function}{\morphComposeHead}
% \begin{syntax}
% \cs{morphComposeHead}\oarg{label}
% \end{syntax}
% \cs{morphComposeHead} (default $\odot$) is composition taken from
% the head of a sequence of functions. An optional argument
% \cs{morphComposeHead}\oarg{label} places \texttt{label} over the
% operator.
% \end{function}
%
% \begin{function}{\morphComposeTail}
% \begin{syntax}
% \cs{morphComposeTail}\oarg{label}
% \end{syntax}
% \cs{morphComposeTail} (default $\cdot$) is composition taken from
% the tail of a sequence of functions. An optional argument
% \cs{morphComposeTail}\oarg{label} places \texttt{label} over the
% operator.
% \end{function}
%
% \begin{quote}
% \textbf{Three distinct compositions:} plain composition, ``compose head,'' and ``compose
% tail'' are genuinely different mathematical operations, not
% glyph/styling variants of one operation. They are built accordingly
% as three separate \pkg{expl3} functions ---
% \cs{lsm_morph_compose:n}, \cs{lsm_morph_compose_head:n},
% \cs{lsm_morph_compose_tail:n} --- each with its own presentation
% hook, the same treatment already given to \cs{catName}/
% \cs{catSeqName} (\cs{lsm_cat_name:n}\slash \cs{lsm_cat_seqname:n}): one
% function with a flag would have re-introduced the
% typography/semantics conflation this package exists to remove.
% \end{quote}
%
% \begin{function}{\morphId}
% \begin{syntax}
% \cs{morphId}\oarg{object}
% \end{syntax}
% \cs{morphId} (Id = Identity) is the identity morphism. The optional
% \meta{object} is the object it acts on, written as a subscript:
% $\operatorname{Id}_A$. Without it, the bare $\operatorname{Id}$ is
% written.
% \end{function}
%
% \begin{function}{\morphSeqId}
% \begin{syntax}
% \cs{morphSeqId}\oarg{object}
% \end{syntax}
% \cs{morphSeqId} is a sequence or tuple of identity morphisms, in
% bold: $\operatorname{\mathbf{Id}}_A$. The optional \meta{object} is
% written as in \cs{morphId}.
% \end{function}
%
% \begin{function}{\morphIncl}
% \begin{syntax}
% \cs{morphIncl}\oarg{included,containing}
% \end{syntax}
% \cs{morphIncl} (Incl = Inclusion) is the inclusion map of
% \meta{included} into \meta{containing}, written with the included
% object as a superscript and the containing object as a subscript:
% $\operatorname{Id}^A_B$. The optional argument is a comma list of at
% most two items; more than two is an error. With one item, only the
% superscript is written; with none, the bare $\operatorname{Id}$. An
% object containing a comma goes in braces. Inclusion is a separate
% command from \cs{morphId}, even where the two render alike, so that
% a style can tell them apart.
% \end{function}
%
% \begin{function}{\morphSeqIncl}
% \begin{syntax}
% \cs{morphSeqIncl}\oarg{included,containing}
% \end{syntax}
% \cs{morphSeqIncl} is a sequence or tuple of inclusion maps, in bold:
% $\operatorname{\mathbf{Id}}^A_B$. The optional argument is as in
% \cs{morphIncl}.
% \end{function}
%
% \begin{function}{\morphInclArrow}
% \begin{syntax}
% \cs{morphInclArrow}
% \end{syntax}
% \cs{morphInclArrow} is the arrow symbol for an inclusion map,
% $\hookrightarrow$, distinct from the tail arrow of \cs{morphMono}.
% \end{function}
%
% \subsection{Charts, atlases, and coordinates}
%
% \begin{function}{\chartName}
% \begin{syntax}
% \cs{chartName}\marg{text}
% \end{syntax}
% \cs{chartName}\Arg{text} is the display name of a chart: a map
% relating part of a space to a model space.
% \end{function}
%
% \begin{function}{\atlasName}
% \begin{syntax}
% \cs{atlasName}\marg{text}
% \end{syntax}
% \cs{atlasName}\Arg{text} is the display name of an atlas: a
