% \subsection{Quantifiers}
% \label{sec:quant-set}
%
% \begin{function}{\equant, \uquant}
% \begin{syntax}
% \cs{equant}\marg{variables}\marg{formula}
% \cs{uquant}\marg{variables}\marg{formula}
% \end{syntax}
% Existential (\cs{equant}) and universal (\cs{uquant}) quantification
% of \meta{formula} over \meta{variables}, a comma list of bound
% variables. How the bound variables are placed and parenthesized is
% set with \cs{setupquant}.
% \end{function}
%
% \begin{function}{\setupquant}
% \begin{syntax}
% \cs{setupquant}\marg{key=value list}
% \end{syntax}
% Sets the rendering of \cs{equant} and \cs{uquant}, independently of
% the style. The keys:
% \begin{description}
% \item[\texttt{subscript}] \texttt{none} (initial): the quantifier
%   symbol followed by the variables, joined by the separator;
%   \texttt{stacked}: the variables stacked under an enlarged
%   quantifier symbol; \texttt{multiple} (the value when the key is
%   given alone): one quantifier symbol per variable, each with its
%   variable as a subscript.
% \item[\texttt{parentheses}] \texttt{none} (initial), \texttt{single}
%   or \texttt{multiple} (the value when the key is given alone). Any
%   value other than \texttt{none} puts the quantifier in parentheses;
%   with \texttt{subscript=multiple}, each quantifier separately.
% \item[\texttt{separator}] The token list written between the
%   variables and before the formula: empty initially, \texttt{.} when
%   the key is given alone.
% \end{description}
% \end{function}
%
