\ProvidesExplPackage{shmuelsemtex}{2026-09-01}{0.6.0}
  {Semantic markup macros for LaTeX (LSM)}
\RequirePackage{xparse}
\RequirePackage{amsmath}
\RequirePackage{bm}
\RequirePackage{scalerel}
