% \section{History}
% \label{sec:history}
%
% The notation in this package was first written as private macros in
% two papers by the package's author, \emph{Local Coordinate Spaces: a
% proposed unification of manifolds and fiber bundles, and associated
% machinery} \cite{lcs} and \emph{Towards a taxonomy of atlases and of
% morphisms between them} \cite{matlas}, which share one set of
% definitions. The papers' macros for categories, functions,
% composition and arrows named their typography, or named a construct
% only loosely; this package gives the same constructs names that say
% what they are, and moves their presentation into styles. The
% quantifier, set-builder, union and intersection, underset-variant and
% sequence-name commands were already semantic, and keep the papers'
% names: in the papers they form a block marked as belonging in a
% package, copyright 2016, whose header describes them as semantic
% markup for common mathematical constructs and grants permission to
% incorporate them, with attribution, in any freely redistributable
% \LaTeX{} package. The sources of the papers now load this package; the versions
% on arXiv use the original macros.
%
% \begin{center}
% \begin{tabular}{ll}
% In the papers & In \pkg{shmuelsemtex} \\
% \hline
% \texttt{\textbackslash catname}, \texttt{\textbackslash cat} & \cs{catName} \\
% \texttt{\textbackslash catseqname} & \cs{catSeqName} \\
% \texttt{\textbackslash funcname} & \cs{morphName} \\
% \texttt{\textbackslash funcseqname} & \cs{morphSeqName} \\
% \texttt{\textbackslash compose} & \cs{morphCompose} \\
% \texttt{\textbackslash composeh} & \cs{morphComposeHead} \\
% \texttt{\textbackslash composet} & \cs{morphComposeTail} \\
% \texttt{\textbackslash into} & \cs{morphMono} \\
% \texttt{\textbackslash onto} & \cs{morphEpi} \\
% \texttt{separater} key of \texttt{\textbackslash setupquant}
%   and \texttt{\textbackslash setupset} & \texttt{separator} \\
% \hline
% \texttt{\textbackslash equant}, \texttt{\textbackslash uquant},
%   \texttt{\textbackslash setupquant} & unchanged \\
% \texttt{\textbackslash set}, \texttt{\textbackslash setupset},
%   \texttt{\textbackslash union}, \texttt{\textbackslash intersection}
%   & unchanged \\
% \texttt{\textbackslash full}, \texttt{\textbackslash maxfull},
%   \texttt{\textbackslash maximal}, \texttt{\textbackslash strict},
