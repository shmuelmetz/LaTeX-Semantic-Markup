% \subsection{Quantifiers}
% \label{sec:quant-set}
%
% \begin{function}{\equant, \uquant}
% \begin{syntax}
% \cs{equant}\marg{variables}\marg{formula}
% \cs{uquant}\marg{variables}\marg{formula}
% \end{syntax}
% Existential (\cs{equant}) and universal (\cs{uquant}) quantification
% of \meta{formula} over \meta{variables}, a comma list of bound
% variables. How the bound variables are placed and parenthesized is
% set with \cs{setupquant}.
% \end{function}
%
% \begin{function}{\setupquant}
% \begin{syntax}
% \cs{setupquant}\marg{key=value list}
% \end{syntax}
% Sets the rendering of \cs{equant} and \cs{uquant}, independently of
% the style. The keys:
% \begin{description}
% \item[\texttt{subscript}] \texttt{none} (initial): the quantifier
%   symbol followed by the variables, joined by the separator;
%   \texttt{stacked}: the variables stacked under an enlarged
%   quantifier symbol; \texttt{multiple} (the value when the key is
%   given alone): one quantifier symbol per variable, each with its
%   variable as a subscript.
% \item[\texttt{parentheses}] \texttt{none} (initial), \texttt{single}
%   or \texttt{multiple} (the value when the key is given alone). Any
%   value other than \texttt{none} puts the quantifier in parentheses;
%   with \texttt{subscript=multiple}, each quantifier separately.
% \item[\texttt{separator}] The token list written between the
%   variables and before the formula: empty initially, \texttt{.} when
%   the key is given alone.
% \end{description}
% \end{function}
%
% \subsection{Set-builder notation}
%
% \begin{function}{\set}
% \begin{syntax}
% \cs{set}\marg{elements}\oarg{propositions}
% \cs{set}\marg{elements}\oarg{propositions}*
% \end{syntax}
% Set-builder notation: \meta{elements} in braces, followed, when
% \meta{propositions} is given, by the separator and the
% propositions. \meta{propositions} is a comma list; each comma is
% typeset as $\land$, so \texttt{\textbackslash set\{x\}[p,q]}
% renders as $\{x \mid p \land q\}$. The starred form
% splits the line between the elements and the propositions, for use
% inside a \env{multline} environment, since \LaTeX{} cannot otherwise
% break a line inside a macro argument. The star follows the
% arguments.
% \end{function}
%
% \begin{function}{\setupset}
% \begin{syntax}
% \cs{setupset}\marg{key=value list}
% \end{syntax}
% Sets the rendering of \cs{set}, \cs{union} and \cs{intersection}.
% The keys:
% \begin{description}
% \item[\texttt{separator}] The symbol between the elements and the
%   propositions of \cs{set}; initially $\mid$.
% \item[\texttt{subscript}] Placement of the indices of \cs{union} and
%   \cs{intersection}: \texttt{stacked} (initial), stacked under an
%   enlarged operator; \texttt{multiple}, a comma-separated subscript.
% \end{description}
% \end{function}
%
% \subsection{Indexed union and intersection}
%
% \begin{function}{\union, \intersection}
% \begin{syntax}
% \cs{union}\oarg{indices}\marg{set}
% \cs{intersection}\oarg{indices}\marg{set}
% \end{syntax}
% Indexed union ($\bigcup$) and intersection ($\bigcap$) of
% \meta{set} over \meta{indices}, a comma list. Without
% \meta{indices}, the bare operator precedes \meta{set}. Index
% placement is set with \cs{setupset}'s \texttt{subscript} key.
% \end{function}
%
% \subsection{Sequence names}
%
% \begin{function}{\seqname}
% \begin{syntax}
% \cs{seqname}\marg{text}
% \end{syntax}
% The name of a sequence, set or tuple: bold upright for a
% multi-character name, bold italic for a single character, the same
% length-based split \cs{catName} uses. It is a separate macro because
% a sequence is a different kind of object from a category.
% \end{function}
